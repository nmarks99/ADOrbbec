include "ADBase.template"

record(stringin, "$(P)$(R)DeviceSelector_RBV") {
    field(DTYP, "asynOctetRead")
    field(INP, "@asyn($(PORT),0,$(TIMEOUT=1))ORBBEC_DEVICE_SELECTOR")
    field(SCAN, "I/O Intr")
}

